  "documents": [
    {
      "id": "regles-sb",
      "titre": "Livre du Joueur (extraits)",
      "sections": [
        {
          "titre": "Création de l'aventurier",
          "blocs": [
            {
              "type": "para",
              "texte": "Sept caractéristiques (FOR, CON, TAI, INT, POU, DEX, CHA), chacune lancée à 3D6 (3-18). Si le total dépasse 52, le livre permet de tout relancer."
            },
            {
              "type": "para",
              "texte": "Santé Mentale de départ = POU × 5. Un repos restaure la SAN (squelette alpha)."
            }
          ]
        },
        {
          "titre": "Les tests",
          "blocs": [
            {
              "type": "para",
              "texte": "Jet sous le pourcentage : 1D100 ≤ seuil. « 01 » = réussite critique, « 00 » = échec automatique. Les caracs se lancent en brute, ×2, ×3 ou ×5 selon l'action."
            }
          ]
        },
        {
          "titre": "Les bonus aux compétences (livre v2, §2.5)",
          "blocs": [
            {
              "type": "para",
              "texte": "Chaque famille gagne un bonus calculé sur les caracs : +1 % par point au-dessus de 12, −1 % par point en dessous de 9 — la TAI s'inverse pour la Parade, l'Agilité et la Discrétion. Une carac qui change, le bonus est recalculé."
            },
            {
              "type": "liste",
              "items": [
                "Attaque : FOR + INT + POU + DEX",
                "Parade : FOR + POU + DEX, moins la TAI",
                "Agilité : FOR + POU + DEX, moins la TAI",
                "Manipulation : FOR + INT + POU + DEX",
                "Perception : INT + POU",
                "Discrétion : INT + DEX, moins la TAI",
                "Communication : CHA + INT + POU",
                "Connaissance : 2 % par point d'INT au-dessus de 12, plus 1 % par année au-delà de 25 ans (Nobles 2 %, Prêtres 3 %)"
              ]
            },
            {
              "type": "para",
              "texte": "Une compétence non apprise de type « Bonus » se joue sur le bonus de sa famille ; « 10 % + » part de 10 + le bonus ; les compétences « 0 % » (Poisons, Plantes, Musique, langues) exigent un maître avant tout jet."
            }
          ]
        },
        {
          "titre": "La lutte de Pouvoir",
          "blocs": [
            {
              "type": "para",
              "texte": "50 % ± 5 % par point d'écart de POU. Les deux réussissent ou échouent : la lutte se prolonge. Défaite : −1D6 SAN."
            }
          ]
        },
        {
          "titre": "Les démons",
          "blocs": [
            {
              "type": "para",
              "texte": "Contrôle : CHA/2 démons liés par l'octogone ; le nombre d'anneaux gravés limite la puissance du démon convoqué."
            }
          ]
        }
      ]
    }
  ]
