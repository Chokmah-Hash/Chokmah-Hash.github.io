  "creation": "unite",
  "textes": {
    "creer": "⚙ Créer une unité",
    "recreer": "↺ Créer une nouvelle unité"
  },
  "journalCreation": "Éveil de {nom} — {chassis} · code {code} · PV {pvMax} (W×3) · Rfx +{rfx} · {arme}",
  "documents": [
    {
      "id": "regles-pe",
      "titre": "Livret des règles (extraits)",
      "sections": [
        {
          "titre": "Les tests",
          "blocs": [
            {
              "type": "para",
              "texte": "Tout test se résout par un jet de 1D6 contre une cible fixe, ajustée par la situation (±1). Un 6 naturel réussit toujours ; un 1 naturel échoue toujours."
            },
            {
              "type": "liste",
              "items": [
                "Cible 2+ : trivial",
                "Cible 3+ : aisé",
                "Cible 4+ : ordinaire",
                "Cible 5+ : difficile",
                "Cible 6+ : héroïque"
              ]
            }
          ]
        },
        {
          "titre": "Le combat",
          "blocs": [
            {
              "type": "para",
              "texte": "La séquence du noyau : toucher → blesser (F vs E) → sauvegarde (PA) → dégâts. L'arme porte tout : attaques, Force, PA, dégâts."
            },
            {
              "type": "table",
              "entetes": [
                "F vs E",
                "Cible de blessure"
              ],
              "lignes": [
                [
                  "F ≥ E×2",
                  "2+"
                ],
                [
                  "F > E",
                  "3+"
                ],
                [
                  "F = E",
                  "4+"
                ],
                [
                  "F < E",
                  "5+"
                ],
                [
                  "F ≤ E/2",
                  "6+"
                ]
              ]
            },
            {
              "type": "para",
              "texte": "Initiative : 1D6 + Rfx (surcharge du mod). À 0 PV, le Protocole de Secours se déclenche : sur 5+, l'unité se redresse avec 1 PV ; sinon, extraction d'urgence hors scène."
            }
          ]
        },
        {
          "titre": "L'éveil — créer une unité",
          "blocs": [
            {
              "type": "para",
              "texte": "Chaque unité naît de l'union d'un châssis (10 profils du manuel joueur) et d'un code de fabrique ; l'arsenal neutre arme le tout."
            },
            {
              "type": "liste",
              "items": [
                "Châssis : profil de base, PV (W×3), Rfx, Mémoire/Calcul, aptitude de châssis, compétences offertes",
                "Codes de fabrique : Éternel, Pragmatique, Sanguinaire, Solaire, Tutélaire, Fondateur",
                "Arsenal : « A » et « F+1 » se résolvent contre les stats de l'unité"
              ]
            }
          ]
        },
        {
          "titre": "Progression (règles maison)",
          "blocs": [
            {
              "type": "para",
              "texte": "Le pack fait la loi des prix : les dépenses se font en fenêtre de progression sanctifiée (HUB) ; le moteur refuse gentiment au-delà du plafond de gains MJ (1 à 3 XP par séance)."
            },
            {
              "type": "table",
              "entetes": [
                "Amélioration",
                "Coût"
              ],
              "lignes": [
                [
                  "+1 PV (max base×2)",
                  "5 XP"
                ],
                [
                  "CC / CT un cran",
                  "10 XP"
                ],
                [
                  "+1 Réflexes",
                  "10 XP"
                ],
                [
                  "Compétence",
                  "8 XP"
                ],
                [
                  "Aptitude",
                  "12 XP"
                ],
                [
                  "+1 Attaque",
                  "12 XP"
                ],
                [
                  "Wargear",
                  "15-25 XP"
                ]
              ]
            }
          ]
        }
      ]
    }
  ]
}
